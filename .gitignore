# C++ build artifacts (regenerated automatically, never need to be committed)
src/*.o
src/*.so
src/*.dll
src/*.a
*.dll

# Stan model executables — {instantiate} compiles these into the installed
# package's bin/stan/ directory, never into src/stan/ in the source tree, but
# ignore anything non-.stan here as a safety net for local ad hoc compiles.
#
# Exception: malrebay_model (+ its bundled libtbb.so.2) is a deliberately
# committed precompiled binary for deploy targets with no CmdStan/compiler
# (e.g. shinyapps.io) — see src/install.libs.R, which skips recompilation
# when it's present. Built in a portable Ubuntu 20.04 container with a
# relative ($ORIGIN) rpath; not just a leftover local build.
src/stan/*
!src/stan/*.stan
!src/stan/malrebay_model
!src/stan/libtbb.so.2

# macOS files ----
.DS_Store

# History files ----
.Rhistory
.Rapp.history

# Session Data files ----
.RData
.Ruserdata

# RStudio files ----
*.Rproj
.Rproj.user/

# knitr cache
*_cache/
__packages/
/cache/
*knit.md
*utf8.md

# R Environment Variables ----
.Renviron

